{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "18.20.4",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "ORG_GRADLE_PROJECT_newArchEnabled": "false"
      },
      "cache": {
        "disabled": true
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "vincent@dasecure.com",
        "ascAppId": "6758430222",
        "appleTeamId": "685L2Q2WD9"
      }
    }
  }
}
