{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "ORG_GRADLE_PROJECT_newArchEnabled": "false"
      },
      "cache": {
        "disabled": true
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "vincent@dasecure.com",
        "ascAppId": "6758430222",
        "appleTeamId": "685L2Q2WD9"
      },
      "android": {
        "serviceAccountKeyPath": "/Users/testaccount/.config/play/iotpush-play-sa.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "ci": {
      "ios": {
        "appleId": "vincent@dasecure.com",
        "ascAppId": "6758430222",
        "appleTeamId": "685L2Q2WD9"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account-key.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
